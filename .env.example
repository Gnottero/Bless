# In locale il sito Next e il servizio di gioco usano due porte diverse.
NEXT_PUBLIC_BLESS_GAME_API=http://127.0.0.1:8788
BLESS_ALLOWED_ORIGIN=http://127.0.0.1:3000

# In produzione lascia NEXT_PUBLIC_BLESS_GAME_API vuoto: /api/game usa lo stesso dominio.
# Collega un archivio Redis compatibile con le API REST di Upstash/Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Segreto lungo e casuale usato per firmare lo stato autoritativo delle partite.
BLESS_GAME_STATE_SECRET=
